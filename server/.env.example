HOST=127.0.0.1
PORT=3001
# Set SERVE_FRONTEND=true to serve the existing build from Express.
# Include that Express URL in FRONTEND_ORIGINS for a same-origin local preview.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Set COOKIE_SECURE=true behind HTTPS. Production requires it.
# Set TRUST_PROXY_HOPS only if the backend can be reached solely through that proxy path.
# Replace with an encoded local PostgreSQL connection URL.
DATABASE_URL=
# Use matching Razorpay Test Mode credentials and a separate test webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
